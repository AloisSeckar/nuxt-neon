{
  "name": "nuxt-neon",
  "version": "0.8.3",
  "description": "Nuxt framework integration with Neon database",
  "repository": "github:AloisSeckar/nuxt-neon",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "pnpm lint && pnpm test:types && pnpm test && pnpm prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run test/test-unit",
    "test:e2e": "vitest run test/test-e2e",
    "test:types": "pnpm test:types:server && pnpm test:types:client && pnpm test:types:module",
    "test:types:module": "tsc --noEmit --module esnext --moduleResolution bundler --skipLibCheck test/neon-types/test-types.ts",
    "test:types:server": "cd src/runtime/server && vue-tsc --noEmit",
    "test:types:client": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@nuxt/kit": "4.5.1",
    "sqlstring": "2.3.3",
    "vite-plugin-commonjs": "0.10.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.0",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/module-builder": "^1.0.0",
    "@nuxt/schema": "4.5.1",
    "@types/node": "^26.1.0",
    "changelogen": "^0.6.0",
    "eslint": "^10.8.0",
    "nuxt": "4.5.1",
    "nuxt-spec": "^0.3.0",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.0"
  },
  "packageManager": "pnpm@11.18.0"
}
